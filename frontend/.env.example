# Copy to .env and fill in from your Supabase dashboard → Project Settings → API.
# The anon key is safe to ship to the browser (that's what it's for) — never put the
# service_role key here.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Local dev: leave unset (Vite's dev proxy in vite.config.js forwards /api to localhost:4000).
# Production (Vercel): set to your deployed backend's URL, e.g. https://your-backend.vercel.app/api
# VITE_API_BASE=https://your-backend.vercel.app/api
