# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API, and → Database).

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://fxxsofjebyxjmoirvjpx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_McvoxNIAu88wXGSRBEuW2A_ijaHL84w

# Project Settings → Database → Connection string ("Connection pooling" tab, URI, port 6543 is fine)
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.fxxsofjebyxjmoirvjpx.supabase.co:5432/postgres

# Comma-separated emails that get the 'admin' role automatically the first time they sign in.
# Use this to bootstrap your own account on a brand-new project.
ADMIN_EMAILS=mjoshi@ailabs.instawork.com
PORT=4000

# Production only (e.g. on Vercel): your deployed frontend's URL, so CORS allows it.
# Leave unset for local dev (then any origin is allowed).
# ALLOWED_ORIGIN=https://your-frontend.vercel.app

# Email notifications (sent to FOs when a new update/quiz is published, with their
# 72-hour deadline). Sign up free at https://resend.com, create an API key, and set:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — sender shown to FOs. The Resend sandbox address works without verifying
# a domain; use your own verified domain's address once you have one.
# RESEND_FROM=FO Training <onboarding@resend.dev>
# Optional — your frontend's URL, included as a link in the notification email.
# APP_URL=https://field-operation-pi.vercel.app
